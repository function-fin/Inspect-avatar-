local function updatePlayerList()
    clearList()
    local filterText = searchBox.Text:lower()
    local players = Players:GetPlayers()
    table.sort(players, function(a, b) return a == LP or (b ~= LP and a.Name:lower() < b.Name:lower()) end)
    
    for _, p in pairs(players) do
        local dispName = p.DisplayName:lower()
        local username = p.Name:lower()
        
        if filterText == "" or dispName:find(filterText, 1, true) or username:find(filterText, 1, true) then
            local cardBtn = create("TextButton", listPage, { Size = UDim2.new(1, -8, 0, 38), BackgroundColor3 = Color3.fromRGB(12, 12, 12), Text = "", ZIndex = 105 }, 6)
            create("UIStroke", cardBtn, { Color = Color3.fromRGB(35, 35, 35), Thickness = 1 })
            
            create("ImageLabel", cardBtn, { Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(0, 10, 0.5, -10), BackgroundTransparency = 1, Image = "rbxassetid://92027896399298", ScaleType = Enum.ScaleType.Fit, ZIndex = 106 })
            
            local txt = (p == LP and "[VOCÊ] " or "") .. p.DisplayName .. " (@" .. p.Name .. ")"
            create("TextLabel", cardBtn, { Size = UDim2.new(1, -85, 1, 0), Position = UDim2.new(0, 38, 0, 0), BackgroundTransparency = 1, Text = txt, TextColor3 = Color3.fromRGB(255, 255, 255), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, TextSize = 11, ZIndex = 106 })
            
            create("ImageLabel", cardBtn, { Size = UDim2.new(0, 22, 0, 22), Position = UDim2.new(1, -20, 0.5, -11), BackgroundTransparency = 1, Image = "rbxassetid://131196469256282", ScaleType = Enum.ScaleType.Fit, ZIndex = 106 })
            
            cardBtn.MouseButton1Click:Connect(function()
                local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
                local s, d = pcall(function() return hum and hum:GetAppliedDescription(hum) end)
                if s and d then
                    local raw = { 
                        Shirt = d.Shirt, 
                        Pants = d.Pants, 
                        Face = d.Face, 
                        Accessories = {}, 
                        BodyParts = { Head = d.Head, Torso = d.Torso, LeftArm = d.LeftArm, RightArm = d.RightArm, LeftLeg = d.LeftLeg, RightLeg = d.RightLeg },
                        Animations = {
                            Idle = d.IdleAnimation,
                            Walk = d.WalkAnimation,
                            Run = d.RunAnimation,
                            Jump = d.JumpAnimation,
                            Fall = d.FallAnimation,
                            Climb = d.ClimbAnimation,
                            Swim = d.SwimAnimation
                        }
                    }
                    for _, a in ipairs(d:GetAccessories(true)) do if a.AssetId and a.AssetId ~= 0 then table.insert(raw.Accessories, a.AssetId) end end
                    displayAvatarData(p.Name, raw)
                end
            end)
        end
    end
end

