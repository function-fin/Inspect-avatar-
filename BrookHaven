local function clonarSkinBrookhaven(skinData)
    if not wearRemote then return end
    local character = LP.Character or LP.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local tentacles, maxTentativas = 0, 2

    repeat
        tentacles = tentacles + 1
        local success, appliedDescription = pcall(function() return humanoid:GetAppliedDescription() end)
        if not success or not appliedDescription then break end
        local itensRestantes = 0
        for _, acessorio in ipairs(appliedDescription:GetAccessories(true)) do
            if acessorio.AssetId and tonumber(acessorio.AssetId) ~= 0 then
                itensRestantes = itensRestantes + 1 pcall(function() wearRemote:InvokeServer(tonumber(acessorio.AssetId)) end) task.wait(0.9)
            end
        end
        if appliedDescription.Shirt and tonumber(appliedDescription.Shirt) ~= 0 then
            itensRestantes = itensRestantes + 1 pcall(function() wearRemote:InvokeServer(tonumber(appliedDescription.Shirt)) end) task.wait(0.9)
        end
        if appliedDescription.Pants and tonumber(appliedDescription.Pants) ~= 0 then
            itensRestantes = itensRestantes + 1 pcall(function() wearRemote:InvokeServer(tonumber(appliedDescription.Pants)) end) task.wait(0.9)
        end
        if appliedDescription.Head and tonumber(appliedDescription.Head) ~= 0 and tonumber(appliedDescription.Head) ~= 4843936835 then
            itensRestantes = itensRestantes + 1 pcall(function() wearRemote:InvokeServer(tonumber(appliedDescription.Head)) end) task.wait(0.9)
        end
        task.wait(0.5)
    until itensRestantes == 0 or tentacles >= maxTentativas

    if skinData.BodyParts then
        for partName, partId in pairs(skinData.BodyParts) do
            if partId and tonumber(partId) ~= 0 and tonumber(partId) ~= 4843936835 then pcall(function() wearRemote:InvokeServer(tonumber(partId)) end) task.wait(0.9) end
        end
    end

    if skinData.Shirt and tonumber(skinData.Shirt) ~= 0 then pcall(function() wearRemote:InvokeServer(tonumber(skinData.Shirt)) end) task.wait(0.9) end
    if skinData.Pants and tonumber(skinData.Pants) ~= 0 then pcall(function() wearRemote:InvokeServer(tonumber(skinData.Pants)) end) task.wait(0.9) end
    if skinData.Face and tonumber(skinData.Face) ~= 0 then pcall(function() wearRemote:InvokeServer(tonumber(skinData.Face)) end) task.wait(0.9) end

    if skinData.Accessories then
        for _, accId in ipairs(skinData.Accessories) do
            if tonumber(accId) ~= 0 then pcall(function() wearRemote:InvokeServer(tonumber(accId)) end) task.wait(0.9) end
        end
    end

    if skinData.Animations then
        for animName, animId in pairs(skinData.Animations) do
            if animId and tonumber(animId) ~= 0 then
                pcall(function() wearRemote:InvokeServer(tonumber(animId)) end)
                task.wait(0.9)
            end
        end
    end
end

-- [NOVO] Wrapper: instant try-on + wearRemote in parallel
local function applySkinToSelf(raw, displayName)
    if not raw then return end
    local rig = detectRigTypeFromRaw(raw)
    local ok = runInstantTryOn(raw, rig)
    if ok then
        -- Schedule cleanup after wearRemote would likely finish.
        -- wearRemote takes ~0.9s per item; count items roughly.
        local itemCount = 1
        if type(raw.Accessories) == "table" then itemCount += #raw.Accessories end
        if raw.Shirt and tonumber(raw.Shirt) ~= 0 then itemCount += 1 end
        if raw.Pants and tonumber(raw.Pants) ~= 0 then itemCount += 1 end
        if raw.Face and tonumber(raw.Face) ~= 0 then itemCount += 1 end
        if type(raw.BodyParts) == "table" then
            for _, v in pairs(raw.BodyParts) do if tonumber(v) and tonumber(v) ~= 0 then itemCount += 1 end end
        end
        local estimatedSeconds = itemCount * 0.9 + 1.5
        task.delay(estimatedSeconds, function()
            -- Only stop if wearRemote didn't already re-apply (avoid nuking real avatar)
            -- The user's real avatar will be visually replaced by wearRemote. We just remove our clone.
            stopInstantTryOn()
        end)
    end
    -- Fire the real Brookhaven wear (slow, server-side)
    task.spawn(clonarSkinBrookhaven, raw)
end

