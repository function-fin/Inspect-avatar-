            create("TextLabel", cardBtn, { Size = UDim2.new(1, -85, 1, 0), Position = UDim2.new(0, 38, 0, 0), BackgroundTransparency = 1, Text = txt, TextColor3 = Color3.fromRGB(255, 255, 255), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, TextSize = 11, ZIndex = 106 })

            create("ImageLabel", cardBtn, { Size = UDim2.new(0, 22, 0, 22), Position = UDim2.new(1, -20, 0.5, -11), BackgroundTransparency = 1, Image = "rbxassetid://131196469256282", ScaleType = Enum.ScaleType.Fit, ZIndex = 106 })

            -- [NOVO] Build raw data once, reuse for both click and hover preview
            local function buildRawFromPlayer()
                local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
                if not hum then return nil end
                local s, d = pcall(function() return hum:GetAppliedDescription(hum) end)
                if not s or not d then return nil end
                local raw = {
                    Shirt = d.Shirt, Pants = d.Pants, Face = d.Face,
                    Accessories = {},
                    BodyParts = { Head = d.Head, Torso = d.Torso, LeftArm = d.LeftArm, RightArm = d.RightArm, LeftLeg = d.LeftLeg, RightLeg = d.RightLeg },
                    Animations = {
                        Idle = d.IdleAnimation, Walk = d.WalkAnimation, Run = d.RunAnimation,
                        Jump = d.JumpAnimation, Fall = d.FallAnimation, Climb = d.ClimbAnimation, Swim = d.SwimAnimation,
                    }
                }
                for _, a in ipairs(d:GetAccessories(true)) do
                    if a.AssetId and a.AssetId ~= 0 then table.insert(raw.Accessories, a.AssetId) end
                end
                return raw
            end

            cardBtn.MouseButton1Click:Connect(function()
                local raw = buildRawFromPlayer()
                if raw then displayAvatarData(p.Name, raw) end
            end)

            -- [NOVO] 3D preview on hover (PC) / long press (mobile)
            if not UserInputService.TouchEnabled then
                cardBtn.MouseEnter:Connect(function()
                    local raw = buildRawFromPlayer()
                    if raw then
                        showHoverPreview(raw, p.DisplayName, detectRigType(p), cardBtn)
                    end
                end)
                cardBtn.MouseLeave:Connect(function()
                    if previewButton == cardBtn then stopHoverPreview() end
                end)
            else
                local pressTime = nil
                cardBtn.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.Touch then
                        pressTime = os.clock()
                        task.delay(0.5, function()
                            if pressTime and os.clock() - pressTime >= 0.45 and previewButton ~= cardBtn then
                                local raw = buildRawFromPlayer()
                                if raw then showHoverPreview(raw, p.DisplayName, detectRigType(p), cardBtn) end
                            end
                        end)
                    end
                end)
                cardBtn.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.Touch then
                        pressTime = nil
                        if previewButton == cardBtn then stopHoverPreview() end
                    end
                end)
            end
        end
    end
end

