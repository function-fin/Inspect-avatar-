-- Reconstruct HumanoidDescription from the "raw" table used by this script.
-- The raw table format is: { Shirt, Pants, Face, BodyParts = {Head,...}, Accessories = {id,...}, Animations = {Idle,...} }
local function parseAssetId(val)
    if not val then return nil end
    if type(val) == "number" then return val > 0 and val or nil end
    local digits = string.match(tostring(val), "%d+")
    return digits and tonumber(digits) or nil
end

local function buildDescriptionFromRaw(raw)
    if type(raw) ~= "table" then return nil end
    local desc = Instance.new("HumanoidDescription")

    local function setNum(prop, value)
        local id = parseAssetId(value)
        if id then pcall(function() desc[prop] = id end) end
    end

    setNum("Shirt", raw.Shirt)
    setNum("Pants", raw.Pants)
    setNum("Face", raw.Face)
    setNum("GraphicTShirt", raw.GraphicTShirt)

    if type(raw.BodyParts) == "table" then
        setNum("Head", raw.BodyParts.Head)
        setNum("Torso", raw.BodyParts.Torso)
        setNum("LeftArm", raw.BodyParts.LeftArm)
        setNum("RightArm", raw.BodyParts.RightArm)
        setNum("LeftLeg", raw.BodyParts.LeftLeg)
        setNum("RightLeg", raw.BodyParts.RightLeg)
    end

    if type(raw.Animations) == "table" then
        setNum("IdleAnimation", raw.Animations.Idle)
        setNum("WalkAnimation", raw.Animations.Walk)
        setNum("RunAnimation", raw.Animations.Run)
        setNum("JumpAnimation", raw.Animations.Jump)
        setNum("FallAnimation", raw.Animations.Fall)
        setNum("ClimbAnimation", raw.Animations.Climb)
        setNum("SwimAnimation", raw.Animations.Swim)
        setNum("SwimIdleAnimation", raw.Animations.SwimIdle)
        setNum("MoodAnimation", raw.Animations.Mood)
    end

    if type(raw.Accessories) == "table" then
        local accessories = {}
        for _, accId in ipairs(raw.Accessories) do
            local parsed = parseAssetId(accId)
            if parsed then
                table.insert(accessories, {
                    AssetId = parsed,
                    AccessoryType = Enum.AccessoryType.Hat,
                    IsLayered = false,
                })
            end
        end
        if #accessories > 0 then
            pcall(function() desc:SetAccessories(accessories, true) end)
        end
    end

    return desc
end

-- Detect rig type of a player (R6 vs R15) — for previews of other players
local function detectRigType(player)
    local hum = player and player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    return hum and hum.RigType or Enum.HumanoidRigType.R15
end

-- Detect rig type from raw data (BodyParts presence of R6 parts)
local function detectRigTypeFromRaw(raw)
    if type(raw) ~= "table" or type(raw.BodyParts) ~= "table" then return Enum.HumanoidRigType.R15 end
    local bp = raw.BodyParts
    -- R6 has Torso; R15 has UpperTorso/LowerTorso in description, but the raw table here only stores Head/Torso/Arms/Legs (R6-style).
    if bp.Torso and bp.Torso ~= 0 then return Enum.HumanoidRigType.R6 end
    return Enum.HumanoidRigType.R15
end

-- LRU cache of preview models
local PREVIEW_CACHE_LIMIT = 16
local previewCache, previewCacheOrder = {}, {}

local function clearPreviewCache()
    for _, model in pairs(previewCache) do pcall(function() model:Destroy() end) end
    table.clear(previewCache)
    table.clear(previewCacheOrder)
end

local function touchPreviewCache(key)
    for i = #previewCacheOrder, 1, -1 do
        if previewCacheOrder[i] == key then table.remove(previewCacheOrder, i) end
    end
    table.insert(previewCacheOrder, key)
    while #previewCacheOrder > PREVIEW_CACHE_LIMIT do
        local oldKey = table.remove(previewCacheOrder, 1)
        local oldModel = previewCache[oldKey]
        previewCache[oldKey] = nil
        pcall(function() if oldModel then oldModel:Destroy() end end)
    end
end

local function getPreviewKey(raw, rigType)
    local ok, encoded = pcall(function()
        return HttpService:JSONEncode({ Raw = raw, Rig = tostring(rigType) })
    end)
    return ok and encoded or tostring(raw)
end

local function buildPreviewTemplate(raw, rigType, cacheKey)
    local desc = buildDescriptionFromRaw(raw)
    if not desc then return nil end

    local ok, model = pcall(function()
        if type(Players.CreateHumanoidModelFromDescriptionAsync) == "function" then
            return Players:CreateHumanoidModelFromDescriptionAsync(desc, rigType)
        end
        return Players:CreateHumanoidModelFromDescription(desc, rigType)
    end)
    pcall(function() desc:Destroy() end)

    if not ok or not model or not model:IsA("Model") then
        if model and typeof(model) == "Instance" then pcall(function() model:Destroy() end) end
        return nil
    end

    model.Parent = nil
    model:PivotTo(CFrame.new(0, 0, 0))

    if cacheKey then
        previewCache[cacheKey] = model
        touchPreviewCache(cacheKey)
    end
    return model
end

