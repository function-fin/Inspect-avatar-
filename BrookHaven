updateSavedList = function()
    clearList() local saved = {} modifyFile(function(f) saved = f end)
    if not next(saved) then
        create("TextLabel", listPage, { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, Text = "NENHUM AVATAR SALVO.", TextColor3 = Color3.fromRGB(140, 140, 140), Font = ARCADE_FONT, TextSize = 12 }) return
    end

    local sortedKeys = {}
    for k in pairs(saved) do table.insert(sortedKeys, k) end
    table.sort(sortedKeys)

    for _, uniqueId in ipairs(sortedKeys) do
        local item = saved[uniqueId]
        local container = create("Frame", listPage, { Size = UDim2.new(1, -8, 0, 35), BackgroundColor3 = Color3.fromRGB(15, 15, 15) }, 6)
