-- Preview state
local previewToken = 0
local previewModel, previewViewport, previewConnection = nil, nil, nil
local previewButton = nil

local function stopHoverPreview()
    previewToken += 1
    previewButton = nil
    if previewConnection then pcall(function() previewConnection:Disconnect() end) previewConnection = nil end
    if previewModel then pcall(function() previewModel:Destroy() end) previewModel = nil end
    previewViewport = nil
    hoverPreview.Visible = false
end

local function createViewport(parent)
    local old = parent:FindFirstChild("Preview")
    if old then old:Destroy() end
    local vp = create("ViewportFrame", parent, {
        Name = "Preview", Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = parent.ZIndex + 1,
    })
    local wm = create("WorldModel", vp, {})
    local cam = create("Camera", vp, { FieldOfView = 30 })
    vp.CurrentCamera = cam
    return vp, wm, cam
end

local function positionCamera(cam, model)
    local head = model:FindFirstChild("Head", true)
    local root = model:FindFirstChild("HumanoidRootPart", true) or head or model.PrimaryPart
    if not root then return end
    local cf, size = model:GetBoundingBox()
    if size.Magnitude <= 0 then return end
    local target = cf.Position + Vector3.new(0, size.Y * 0.04, 0)
    local look = head and head.CFrame.LookVector or root.CFrame.LookVector
    if look.Magnitude == 0 then look = Vector3.new(0, 0, -1) end
    local distance = math.max(math.max(size.Y, size.X, size.Z) * 1.85, 5.5)
    cam.CFrame = CFrame.lookAt(target + look.Unit * distance, target)
end

local function showHoverPreview(raw, displayName, rigType, anchorButton)
    if not raw then return end
    stopHoverPreview()
    local token = previewToken

    hoverName.Text = tostring(displayName or "Skin")
    hoverStatus.Text = "Carregando..."
    hoverStatus.Visible = true
    hoverPreview.Visible = true
    previewButton = anchorButton

    -- Position next to the button
    if anchorButton then
        local abs = anchorButton.AbsolutePosition
        local size = anchorButton.AbsoluteSize
        local x = abs.X + size.X + 8
        local y = abs.Y - 40
        -- Clamp inside the screen
        local cam = workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
        local scale = math.max(uiScale.Scale, 0.01)
        if x + 200 > vp.X then x = abs.X - 208 end
        if y < 0 then y = 0 end
        if y + 260 > vp.Y then y = vp.Y - 260 end
        hoverPreview.Position = UDim2.new(0, x / scale, 0, y / scale)
    end

    task.spawn(function()
        local vp, wm, cam = createViewport(hoverViewportHolder)
        if not vp then
            hoverStatus.Text = "Erro: viewport"
            return
        end

        local key = getPreviewKey(raw, rigType)
        local template = previewCache[key]
        if template and template.Parent ~= nil then
            previewCache[key] = nil
            template = nil
        elseif template then
            touchPreviewCache(key)
        end

        if not template then
            template = buildPreviewTemplate(raw, rigType, key)
        end

        if not template then
            hoverStatus.Text = "Falha ao gerar preview.\n(Verifique se os IDs são válidos.)"
            return
        end

        if token ~= previewToken or not hoverPreview.Visible then return end

        local okClone, model = pcall(function() return template:Clone() end)
        if not okClone or not model then
            hoverStatus.Text = "Falha ao clonar."
            return
        end

        model.Parent = wm
        model:PivotTo(CFrame.new(0, 0, 0))
        previewModel = model
        previewViewport = vp

        positionCamera(cam, model)
        cam.FieldOfView = 35

        hoverStatus.Visible = false

        local angle = 0
        previewConnection = game:GetService("RunService").RenderStepped:Connect(function(dt)
            if token ~= previewToken or not hoverPreview.Visible or not model.Parent then
                stopHoverPreview()
                return
            end
            angle += dt * math.rad(70)
            pcall(function() model:PivotTo(CFrame.Angles(0, angle, 0)) end)
        end)
    end)
end

