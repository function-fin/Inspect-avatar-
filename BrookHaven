local function create(className, parent, props, cornerRadius)
    local inst = Instance.new(className)
    for k, v in pairs(props or {}) do inst[k] = v end
    if cornerRadius then Instance.new("UICorner", inst).CornerRadius = UDim.new(0, cornerRadius) end
    inst.Parent = parent
    return inst
end

-- === SISTEMA DE ARQUIVOS === --
local function modifyFile(callback)
    local s, content = pcall(function() return readfile and readfile(FILE_NAME) end)
    local saved = (s and content and content ~= "") and HttpService:JSONDecode(content) or {}
    callback(saved)
    pcall(function() if writefile then writefile(FILE_NAME, HttpService:JSONEncode(saved)) end end)
end

