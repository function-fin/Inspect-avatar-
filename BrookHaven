-- ============================================================

local instantTryOnState = {
    Model = nil,
    Conn = nil,
    Hidden = {}, -- [BasePart] = originalTransparency
    HiddenDecals = {},
}

local function isExternalAttachment(instance, character)
    if instance:FindFirstAncestorOfClass("Tool") or instance:FindFirstAncestorOfClass("VehicleSeat") then return true end
    -- Only body parts/decals directly under the character
    local top = instance
    while top and top.Parent and top.Parent ~= character do top = top.Parent end
    if not top or top.Parent ~= character then return true end
    if top:IsA("Accessory") then return false end
    local bodyNames = {
        Head = true, HumanoidRootPart = true, Torso = true, UpperTorso = true, LowerTorso = true,
        ["Left Arm"] = true, ["Right Arm"] = true, ["Left Leg"] = true, ["Right Leg"] = true,
        LeftUpperArm = true, LeftLowerArm = true, LeftHand = true,
        RightUpperArm = true, RightLowerArm = true, RightHand = true,
        LeftUpperLeg = true, LeftLowerLeg = true, LeftFoot = true,
        RightUpperLeg = true, RightLowerLeg = true, RightFoot = true,
    }
    if top:IsA("BasePart") and bodyNames[top.Name] then return false end
    return true
end

local function hideInstance(instance, character)
    if not instance or not character or not instance:IsDescendantOf(character) then return end
    if isExternalAttachment(instance, character) then return end
    if instance:IsA("BasePart") then
        if instantTryOnState.Hidden[instance] == nil then
            instantTryOnState.Hidden[instance] = instance.LocalTransparencyModifier
        end
        instance.LocalTransparencyModifier = 1
    elseif instance:IsA("Decal") or instance:IsA("Texture") then
        if instantTryOnState.HiddenDecals[instance] == nil then
            instantTryOnState.HiddenDecals[instance] = instance.Transparency
        end
        instance.Transparency = 1
    end
end

local function hideCharacter(character)
    for _, inst in ipairs(character:GetDescendants()) do
        hideInstance(inst, character)
    end
end

local function restoreCharacter()
    for part, t in pairs(instantTryOnState.Hidden) do
        pcall(function() if part and part.Parent then part.LocalTransparencyModifier = t end end)
    end
    table.clear(instantTryOnState.Hidden)
    for decal, t in pairs(instantTryOnState.HiddenDecals) do
        pcall(function() if decal and decal.Parent then decal.Transparency = t end end)
    end
    table.clear(instantTryOnState.HiddenDecals)
end

local function stopInstantTryOn()
    if instantTryOnState.Conn then pcall(function() instantTryOnState.Conn:Disconnect() end) instantTryOnState.Conn = nil end
    if instantTryOnState.Model then pcall(function() instantTryOnState.Model:Destroy() end) instantTryOnState.Model = nil end
    restoreCharacter()
end

local function prepareModel(model)
    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        hum.RequiresNeck = false
        hum.AutomaticScalingEnabled = false
        pcall(function() hum.EvaluateStateMachine = false end)
        for _, st in ipairs(Enum.HumanoidStateType:GetEnumItems()) do
            if st ~= Enum.HumanoidStateType.None then pcall(function() hum:SetStateEnabled(st, false) end) end
        end
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.None) end)
    end
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    for _, inst in ipairs(model:GetDescendants()) do
        if inst:IsA("BasePart") then
            inst.Anchored = (inst == root)
            inst.CanCollide = false
            inst.CanTouch = false
            inst.CanQuery = false
            inst.Massless = true
            inst.LocalTransparencyModifier = 0
        elseif inst:IsA("Decal") or inst:IsA("Texture") then
            pcall(function() inst.LocalTransparencyModifier = 0 end)
        elseif inst:IsA("Script") or inst:IsA("LocalScript") then
            pcall(function() inst.Disabled = true end)
        end
    end
end

local function getFeetBottomY(model)
    local names = { "LeftFoot", "RightFoot", "Left Leg", "Right Leg" }
    local lowest = math.huge
    local found = false
    local seen = {}
    for _, n in ipairs(names) do
        local foot = model:FindFirstChild(n, true)
        if foot and foot:IsA("BasePart") and not seen[foot] then
            seen[foot] = true
            found = true
            local half = foot.Size / 2
            for _, x in ipairs({ -half.X, half.X }) do
                for _, y in ipairs({ -half.Y, half.Y }) do
                    for _, z in ipairs({ -half.Z, half.Z }) do
                        local wp = foot.CFrame:PointToWorldSpace(Vector3.new(x, y, z))
                        if wp.Y < lowest then lowest = wp.Y end
                    end
                end
            end
        end
    end
    return found and lowest or nil
end

-- Instant local try-on: builds a clone of the skin, anchors it to the player,
-- follows the player every frame, hides the real character locally.
-- Runs in parallel with wearRemote (which does the real server-side apply).
local function runInstantTryOn(raw, rigType)
    if type(raw) ~= "table" then return false end
    if not LP.Character then return false end
    local character = LP.Character
    local charRoot = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
    if not charRoot then return false end

    stopInstantTryOn()

    local desc = buildDescriptionFromRaw(raw)
    if not desc then return false end

    local ok, model = pcall(function()
        if type(Players.CreateHumanoidModelFromDescriptionAsync) == "function" then
            return Players:CreateHumanoidModelFromDescriptionAsync(desc, rigType)
        end
        return Players:CreateHumanoidModelFromDescription(desc, rigType)
    end)
    pcall(function() desc:Destroy() end)

    if not ok or not model or not model:IsA("Model") then
        if model and typeof(model) == "Instance" then pcall(function() model:Destroy() end) end
        return false
    end

    model.Name = "CubnitOmni_InstantTryOn"
    prepareModel(model)
    model.Parent = workspace

    local cloneRoot = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChild("Head", true)
    if not cloneRoot then
        pcall(function() model:Destroy() end)
        return false
    end

    -- Compute feet offset (clone feet vs player feet)
    local charFeet = getFeetBottomY(character)
    local cloneFeet = getFeetBottomY(model)
    local yOffset = (charFeet and cloneFeet) and (charFeet - cloneFeet) or 0

    cloneRoot.CFrame = charRoot.CFrame + Vector3.new(0, yOffset, 0)

    -- Hide the real character locally
    hideCharacter(character)

    instantTryOnState.Model = model

    -- Follow the player every frame
    instantTryOnState.Conn = game:GetService("RunService").RenderStepped:Connect(function()
        if not instantTryOnState.Model or not instantTryOnState.Model.Parent then
            stopInstantTryOn()
            return
        end
        if not LP.Character or not LP.Character.Parent then
            stopInstantTryOn()
            return
        end
        local cRoot = LP.Character:FindFirstChild("HumanoidRootPart") or LP.Character.PrimaryPart
        if not cRoot then return end
        local r = instantTryOnState.Model:FindFirstChild("HumanoidRootPart") or instantTryOnState.Model.PrimaryPart
        if not r then return end
        r.CFrame = cRoot.CFrame + Vector3.new(0, yOffset, 0)
        -- Re-hide character parts in case they got restored by external scripts
        for part, t in pairs(instantTryOnState.Hidden) do
            if part and part.Parent and part.LocalTransparencyModifier ~= 1 then
                part.LocalTransparencyModifier = 1
            end
        end
    end)

    return true
end

