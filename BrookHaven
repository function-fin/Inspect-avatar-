        b.MouseButton1Click:Connect(function() displayAvatarData(item.Name, item.Data) end)

        local copySkinBtn = create("ImageButton", container, { Size = UDim2.new(0, 22, 0, 22), Position = UDim2.new(1, -66, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), BackgroundTransparency = 1, Image = "rbxassetid://133764834615931", ScaleType = Enum.ScaleType.Fit, ZIndex = 106 })
        copySkinBtn.MouseButton1Click:Connect(function() task.spawn(clonarSkinBrookhaven, item.Data) end)

        local function createActionBtn(img, xOffset, cb)
            local btn = create("ImageButton", container, { Size = UDim2.new(0, 22, 0, 22), Position = UDim2.new(1, xOffset, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), BackgroundTransparency = 1, Image = "rbxassetid://"..img, ScaleType = Enum.ScaleType.Fit, ZIndex = 106 })
            btn.MouseButton1Click:Connect(cb)
        end
        createActionBtn("105157650009654", -38, function() activeRenameId, renameInput.Text, renameGui.Visible = uniqueId, item.Name, true end)
        createActionBtn("98235327129327", -10, function() modifyFile(function(f) f[uniqueId] = nil end) updateSavedList() end)
    end
end

