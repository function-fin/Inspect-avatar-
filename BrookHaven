local function createCard(id, defName)
    if not id or tostring(id) == "0" or id == "" then return end
    local card = create("TextButton", gridScroll, { BackgroundColor3 = Color3.fromRGB(15, 15, 15), Text = "", ZIndex = 104 }, 6)
    create("UIStroke", card, { Color = Color3.fromRGB(40, 40, 40), Thickness = 1 })
    create("ImageLabel", card, { Size = UDim2.new(1, -10, 0, 65), Position = UDim2.new(0, 5, 0, 5), BackgroundTransparency = 1, Image = "rbxthumb://type=Asset&id=" .. id .. "&w=150&h=150", ZIndex = 105 })
    local label = create("TextLabel", card, { Size = UDim2.new(1, -6, 0, 35), Position = UDim2.new(0, 3, 1, -45), Text = "...", TextColor3 = Color3.fromRGB(200, 200, 200), TextSize = 8, Font = Enum.Font.Gotham, TextWrapped = true, BackgroundTransparency = 1, ZIndex = 105 })
    
    task.spawn(function()
        local s, info = pcall(Marketplace.GetProductInfo, Marketplace, id)
        label.Text = s and info and info.Name or defName
    end)
    card.MouseButton1Click:Connect(function() currentId = id cMsg.Text = "COPIAR ID DO: " .. defName:upper() confirmGui.Visible = true end)
end

local function displayAvatarData(name, data)
    if not data then return end
    listPage.Visible, detailPage.Visible = false, true
    title.Text, currentInspectedName, currentInspectedData = "INSPECIONANDO: " .. name:upper(), name, data
    updateVisibility()

    for _, v in pairs(gridScroll:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    createCard(data.Shirt, "Camisa") createCard(data.Pants, "Calça") createCard(data.Face, "Rosto")
    for part, id in pairs(data.BodyParts or {}) do createCard(id, part) end
    for _, accId in ipairs(data.Accessories or {}) do createCard(accId, "Acessório") end
end

local function clearList() for _, v in pairs(listPage:GetChildren()) do if v:IsA("Frame") or v:IsA("TextButton") then v:Destroy() end end end

local function updatePlayerList()
    clearList()
    local players = Players:GetPlayers()
    table.sort(players, function(a, b) return a == LP or (b ~= LP and a.Name:lower() < b.Name:lower()) end)
    for _, p in pairs(players) do
        local b = create("TextButton", listPage, { Size = UDim2.new(1, -8, 0, 35), BackgroundColor3 = Color3.fromRGB(15, 15, 15), Text = "   " .. (p == LP and "[VOCÊ] " or "") .. p.DisplayName .. " (@" .. p.Name .. ")", TextColor3 = Color3.fromRGB(255, 255, 255), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, TextSize = 13, ZIndex = 105 }, 6)
        create("UIStroke", b, { Color = Color3.fromRGB(35, 35, 35), Thickness = 1 })
        b.MouseButton1Click:Connect(function()
            local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
            local s, d = pcall(function() return hum and hum:GetAppliedDescription(hum) end)
            if s and d then
                local raw = { Shirt = d.Shirt, Pants = d.Pants, Face = d.Face, Accessories = {}, BodyParts = { Head = d.Head, Torso = d.Torso, LeftArm = d.LeftArm, RightArm = d.RightArm, LeftLeg = d.LeftLeg, RightLeg = d.RightLeg } }
                for _, a in ipairs(d:GetAccessories(true)) do if a.AssetId and a.AssetId ~= 0 then table.insert(raw.Accessories, a.AssetId) end end
                displayAvatarData(p.Name, raw)
            end
        end)
    end
end

local function updateSavedList()
    clearList()
    local saved = {}
    modifyFile(function(f) saved = f end)
    if not next(saved) then
        create("TextLabel", listPage, { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, Text = "NENHUM AVATAR SALVO.", TextColor3 = Color3.fromRGB(140, 140, 140), Font = Enum.Font.FredokaOne, TextSize = 12 })
        return
    end
    for uniqueId, item in pairs(saved) do
        local container = create("Frame", listPage, { Size = UDim2.new(1, -8, 0, 35), BackgroundColor3 = Color3.fromRGB(15, 15, 15) }, 6)
        create("UIStroke", container, { Color = Color3.fromRGB(45, 45, 45), Thickness = 1 })
        
        local b = create("TextButton", container, { Size = UDim2.new(1, -75, 1, 0), BackgroundTransparency = 1, Text = "   " .. item.Name .. " (Salvo em: " .. (item.SavedAt or "n/a") .. ")", TextColor3 = Color3.fromRGB(255, 255, 255), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, TextSize = 11, ZIndex = 105 })
        b.MouseButton1Click:Connect(function() displayAvatarData(item.Name, item.Data) end)
        
        local function createActionBtn(img, xOffset, cb)
            local btn = create("ImageButton", container, { Size = UDim2.new(0, 22, 0, 22), Position = UDim2.new(1, xOffset, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), BackgroundTransparency = 1, Image = "rbxassetid://"..img, ScaleType = Enum.ScaleType.Fit, ZIndex = 106 })
            btn.MouseButton1Click:Connect(cb)
        end
        
        createActionBtn("105157650009654", -38, function() activeRenameId, renameInput.Text, renameGui.Visible = uniqueId, item.Name, true end)
        createActionBtn("98235327129327", -10, function() modifyFile(function(f) f[uniqueId] = nil end) updateSavedList() end)
    end
end

