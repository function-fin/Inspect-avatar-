-- Movimentação do Launcher
launcher.InputBegan:Connect(function(i) 
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then 
        dragging, hasMoved, dStart, sPos = true, false, i.Position, launcher.Position 
    end 
end)

UserInputService.InputChanged:Connect(function(i) 
    if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then 
        local delta = i.Position - dStart 
        if delta.Magnitude > 5 then hasMoved = true end
        launcher.Position = UDim2.new(sPos.X.Scale, sPos.X.Offset + delta.X, sPos.Y.Scale, sPos.Y.Offset + delta.Y) 
    end 
end)

UserInputService.InputEnded:Connect(function(i)
    if (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) and dragging then
        dragging = false
        if not hasMoved then
            main.Visible = not main.Visible 
            if main.Visible then 
                -- Toda vez que abrir através do launcher, reseta estritamente para a aba inicial de jogadores
                returnToMainPlayers() 
            end 
            confirmGui.Visible, renameGui.Visible = false, false
        end
    end
end)

local function autoUpdateList() if main.Visible and currentTab == "Players" and not detailPage.Visible then updatePlayerList() end end
Players.PlayerAdded:Connect(autoUpdateList)
Players.PlayerRemoving:Connect(autoUpdateList)

