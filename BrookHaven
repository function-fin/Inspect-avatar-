local function parseAssetId(val)
    if not val then return nil end
    if type(val) == "number" then return val > 0 and val or nil end
    local digits = string.match(tostring(val), "%d+")
    return digits and tonumber(digits) or nil
end

local ACCESSORY_TYPE_BY_NAME = {}
for _, t in ipairs(Enum.AccessoryType:GetEnumItems()) do ACCESSORY_TYPE_BY_NAME[t.Name] = t end

local function colorToTable(c)
    if typeof(c) ~= "Color3" then return nil end
    return { R = math.floor(c.R * 255 + 0.5), G = math.floor(c.G * 255 + 0.5), B = math.floor(c.B * 255 + 0.5) }
end

local function tableToColor(t)
    if type(t) ~= "table" then return nil end
    return Color3.fromRGB(tonumber(t.R or t.r) or 255, tonumber(t.G or t.g) or 255, tonumber(t.B or t.b) or 255)
end

local function vec3ToTable(v, fallback)
    fallback = fallback or Vector3.zero
    if typeof(v) ~= "Vector3" then return { X = fallback.X, Y = fallback.Y, Z = fallback.Z } end
    return { X = v.X, Y = v.Y, Z = v.Z }
end

local function tableToVec3(t, fallback)
    fallback = fallback or Vector3.zero
    if type(t) ~= "table" then return fallback end
    return Vector3.new(tonumber(t.X or t.x) or fallback.X, tonumber(t.Y or t.y) or fallback.Y, tonumber(t.Z or t.z) or fallback.Z)
end

local function serializeFullDescription(hum)
    if not hum then return nil end
    local ok, desc = pcall(function() return hum:GetAppliedDescription() end)
    if not ok or not desc then return nil end

    local data = {}
    for _, key in ipairs({ "Shirt", "Pants", "GraphicTShirt", "Face", "Head", "Torso", "LeftArm", "RightArm", "LeftLeg", "RightLeg", "IdleAnimation", "WalkAnimation", "RunAnimation", "JumpAnimation", "FallAnimation", "ClimbAnimation", "SwimAnimation", "SwimIdleAnimation", "MoodAnimation" }) do
        local ok2, v = pcall(function() return desc[key] end) if ok2 and v then data[key] = v end
    end
    for _, key in ipairs({ "HeightScale", "WidthScale", "DepthScale", "BodyTypeScale", "HeadScale", "ProportionScale" }) do
        local ok2, v = pcall(function() return desc[key] end) if ok2 and v then data[key] = v end
    end
    for _, key in ipairs({ "HeadColor", "TorsoColor", "LeftArmColor", "RightArmColor", "LeftLegColor", "RightLegColor" }) do
        local ok2, v = pcall(function() return desc[key] end) if ok2 and v then data[key] = colorToTable(v) end
    end
    local okAcc, accessories = pcall(function() return desc:GetAccessories(true) end)
    if okAcc and type(accessories) == "table" then
        data.Accessories = {}
        for _, a in ipairs(accessories) do
            local entry = { AssetId = a.AssetId, AccessoryType = a.AccessoryType and a.AccessoryType.Name or "Hat", IsLayered = a.IsLayered == true }
            if a.Order ~= nil then entry.Order = a.Order end
            if a.Puffiness ~= nil then entry.Puffiness = a.Puffiness end
            if a.Position then entry.Position = vec3ToTable(a.Position) end
            if a.Rotation then entry.Rotation = vec3ToTable(a.Rotation) end
            if a.Scale then entry.Scale = vec3ToTable(a.Scale, Vector3.one) end
            table.insert(data.Accessories, entry)
        end
    end
    local okMk, makeups = pcall(function() return desc:GetMakeups() end)
    if okMk and type(makeups) == "table" then
        data.MakeupItems = {}
        for _, m in ipairs(makeups) do table.insert(data.MakeupItems, { AssetId = m.AssetId, MakeupType = m.MakeupType and m.MakeupType.Name or "Lip", Order = m.Order or 1 }) end
    end
    local okEm, emotes = pcall(function() return desc:GetEmotes() end) if okEm and type(emotes) == "table" then data.Emotes = emotes end
    local okEq, equipped = pcall(function() return desc:GetEquippedEmotes() end) if okEq and type(equipped) == "table" then data.EquippedEmotes = equipped end
    local okSh, shape = pcall(function() for _, child in ipairs(desc:GetChildren()) do if child:IsA("BodyPartDescription") and child.BodyPart == Enum.BodyPart.Head then return child.HeadShape end end return nil end)
    if okSh and shape and shape ~= "" then data.HeadShape = shape end
    if hum.RigType then data.RigType = (hum.RigType == Enum.HumanoidRigType.R6) and "R6" or "R15" end
    pcall(function() desc:Destroy() end)
    return data
end

local function buildDescriptionFromFull(full)
    if type(full) ~= "table" then return nil end
    local desc = Instance.new("HumanoidDescription")
    local function setNum(prop, value) local id = parseAssetId(value) if id then pcall(function() desc[prop] = id end) end end
    for _, key in ipairs({ "Shirt", "Pants", "GraphicTShirt", "Face", "Head", "Torso", "LeftArm", "RightArm", "LeftLeg", "RightLeg", "IdleAnimation", "WalkAnimation", "RunAnimation", "JumpAnimation", "FallAnimation", "ClimbAnimation", "SwimAnimation", "SwimIdleAnimation", "MoodAnimation" }) do setNum(key, full[key]) end
    for _, key in ipairs({ "HeightScale", "WidthScale", "DepthScale", "BodyTypeScale", "HeadScale", "ProportionScale" }) do local v = tonumber(full[key]) if v then pcall(function() desc[key] = v end) end end
    
    local hasAnyColor = false
    for _, key in ipairs({ "HeadColor", "TorsoColor", "LeftArmColor", "RightArmColor", "LeftLegColor", "RightLegColor" }) do
        local c = tableToColor(full[key]) if c then pcall(function() desc[key] = c end) hasAnyColor = true end
    end
    if not hasAnyColor then
        local neutral = Color3.fromRGB(205, 170, 125)
        pcall(function() desc.HeadColor = neutral; desc.TorsoColor = neutral; desc.LeftArmColor = neutral; desc.RightArmColor = neutral; desc.LeftLegColor = neutral; desc.RightLegColor = neutral end)
    end

    if type(full.Accessories) == "table" then
        local accessories = {}
        for _, a in ipairs(full.Accessories) do
            if type(a) == "table" and a.AssetId then
                local entry = { AssetId = parseAssetId(a.AssetId), AccessoryType = ACCESSORY_TYPE_BY_NAME[a.AccessoryType or "Hat"] or Enum.AccessoryType.Hat, IsLayered = a.IsLayered == true }
                if a.Order ~= nil then entry.Order = a.Order end
                if a.Puffiness ~= nil then entry.Puffiness = a.Puffiness end
                if a.Position then entry.Position = tableToVec3(a.Position) end
                if a.Rotation then entry.Rotation = tableToVec3(a.Rotation) end
                if a.Scale then entry.Scale = tableToVec3(a.Scale, Vector3.one) end
                if entry.AssetId then table.insert(accessories, entry) end
            end
        end
        if #accessories > 0 then pcall(function() desc:SetAccessories(accessories, true) end) end
    end
    if type(full.MakeupItems) == "table" then
        for _, m in ipairs(full.MakeupItems) do
            if type(m) == "table" and m.AssetId then
                pcall(function()
                    local makeup = Instance.new("MakeupDescription")
                    makeup.AssetId = parseAssetId(m.AssetId) makeup.Order = m.Order or 1
                    makeup.MakeupType = Enum.MakeupType[m.MakeupType or "Lip"] or Enum.MakeupType.Lip
                    makeup.Parent = desc
                end)
            end
        end
    end
    if type(full.Emotes) == "table" then pcall(function() desc:SetEmotes(full.Emotes) end) end
    if type(full.EquippedEmotes) == "table" then pcall(function() desc:SetEquippedEmotes(full.EquippedEmotes) end) end
    if full.HeadShape and full.HeadShape ~= "" then
        pcall(function()
            local hp = Instance.new("BodyPartDescription")
            hp.BodyPart = Enum.BodyPart.Head hp.AssetId = desc.Head hp.HeadShape = full.HeadShape hp.Parent = desc
        end)
    end
    return desc
end

local function buildDescriptionFromRaw(raw)
    if type(raw) ~= "table" then return nil end
    if type(raw.Full) == "table" then local d = buildDescriptionFromFull(raw.Full) if d then return d end end
    local desc = Instance.new("HumanoidDescription")
    local function setNum(prop, value) local id = parseAssetId(value) if id then pcall(function() desc[prop] = id end) end end
    setNum("Shirt", raw.Shirt) setNum("Pants", raw.Pants) setNum("Face", raw.Face) setNum("GraphicTShirt", raw.GraphicTShirt)
    if type(raw.BodyParts) == "table" then
        setNum("Head", raw.BodyParts.Head) setNum("Torso", raw.BodyParts.Torso) setNum("LeftArm", raw.BodyParts.LeftArm) setNum("RightArm", raw.BodyParts.RightArm) setNum("LeftLeg", raw.BodyParts.LeftLeg) setNum("RightLeg", raw.BodyParts.RightLeg)
    end
    if type(raw.Animations) == "table" then
        setNum("IdleAnimation", raw.Animations.Idle) setNum("WalkAnimation", raw.Animations.Walk) setNum("RunAnimation", raw.Animations.Run) setNum("JumpAnimation", raw.Animations.Jump) setNum("FallAnimation", raw.Animations.Fall) setNum("ClimbAnimation", raw.Animations.Climb) setNum("SwimAnimation", raw.Animations.Swim) setNum("SwimIdleAnimation", raw.Animations.SwimIdle) setNum("MoodAnimation", raw.Animations.Mood)
    end
    if type(raw.Accessories) == "table" then
        local accessories = {}
        for _, accId in ipairs(raw.Accessories) do local parsed = parseAssetId(accId) if parsed then table.insert(accessories, { AssetId = parsed, AccessoryType = Enum.AccessoryType.Hat, IsLayered = false }) end end
        if #accessories > 0 then pcall(function() desc:SetAccessories(accessories, true) end) end
    end
    pcall(function()
        local neutral = Color3.fromRGB(205, 170, 125)
        desc.HeadColor = neutral desc.TorsoColor = neutral desc.LeftArmColor = neutral desc.RightArmColor = neutral desc.LeftLegColor = neutral desc.RightLegColor = neutral
    end)
    return desc
end

local function detectRigTypeFromRaw(raw)
    if type(raw) ~= "table" then return Enum.HumanoidRigType.R15 end
    if type(raw.Full) == "table" and raw.Full.RigType then return (raw.Full.RigType == "R6") and Enum.HumanoidRigType.R6 or Enum.HumanoidRigType.R15 end
    if type(raw.BodyParts) == "table" then local bp = raw.BodyParts if bp.Torso and tonumber(bp.Torso) and tonumber(bp.Torso) ~= 0 then return Enum.HumanoidRigType.R6 end end
    return Enum.HumanoidRigType.R15
end

local PREVIEW_CACHE_LIMIT = 16
local previewCache, previewCacheOrder = {}, {}
local function clearPreviewCache() for _, model in pairs(previewCache) do pcall(function() model:Destroy() end) end table.clear(previewCache) table.clear(previewCacheOrder) end
local function touchPreviewCache(key)
    for i = #previewCacheOrder, 1, -1 do if previewCacheOrder[i] == key then table.remove(previewCacheOrder, i) end end
    table.insert(previewCacheOrder, key)
    while #previewCacheOrder > PREVIEW_CACHE_LIMIT do local oldKey = table.remove(previewCacheOrder, 1) local oldModel = previewCache[oldKey] previewCache[oldKey] = nil pcall(function() if oldModel then oldModel:Destroy() end end) end
end
local function getPreviewKey(raw, rigType)
    local ok, encoded = pcall(function() return HttpService:JSONEncode({ Raw = raw, Rig = tostring(rigType) }) end)
    return ok and encoded or tostring(raw)
end

local function buildPreviewTemplate(raw, rigType, cacheKey)
    local desc, rigTypeFromFull
    if type(raw) == "table" and type(raw.Full) == "table" then desc = buildDescriptionFromFull(raw.Full) if raw.Full.RigType then rigTypeFromFull = raw.Full.RigType end end
    if not desc then desc = buildDescriptionFromRaw(raw) end
    if not desc then return nil end
    if rigTypeFromFull == "R6" then rigType = Enum.HumanoidRigType.R6 elseif rigTypeFromFull == "R15" then rigType = Enum.HumanoidRigType.R15 end

    local ok, model = pcall(function()
        if type(Players.CreateHumanoidModelFromDescriptionAsync) == "function" then return Players:CreateHumanoidModelFromDescriptionAsync(desc, rigType) end
        return Players:CreateHumanoidModelFromDescription(desc, rigType)
    end)
    pcall(function() desc:Destroy() end)
    if not ok or not model or not model:IsA("Model") then if model and typeof(model) == "Instance" then pcall(function() model:Destroy() end) end return nil end
    model.Parent = nil
    model:PivotTo(CFrame.new(0, 0, 0))
    if cacheKey then previewCache[cacheKey] = model touchPreviewCache(cacheKey) end
    return model
end

